# SuperARB / LIQ2 environment template
#
# Copy this file to .env before starting the dashboard.
# Windows:     copy .env.example .env
# macOS/Linux: cp .env.example .env
#
# Minimum required startup fields:
# - PRIVATE_KEY
# - SUPERMTNODE_APP_TOKEN
# - BNB_RPC_URL
# - AUTH_CODE
#
# Keep secrets out of screenshots, Git commits, issue reports, and chat logs.


# -----------------------------------------------------------------------------
# 1. Wallet & License
# -----------------------------------------------------------------------------
# Settings > 通用:
# - 钱包私钥 -> PRIVATE_KEY
# - SUPERMTNODE_APP_TOKEN -> SUPERMTNODE_APP_TOKEN
# - 授权码 -> AUTH_CODE
#
# PRIVATE_KEY
#   Required. Execution wallet private key. Use a dedicated operational wallet.
#
# SUPERMTNODE_APP_TOKEN
#   Required. Official SuperMTNode app/license token. RPC quota can be shared by
#   the same token + RPC endpoints across different private keys, while each
#   wallet remains separately metered by its own execution activity.
#
# AUTH_CODE
#   Required. SuperARB dashboard authorization code. The browser login stores it
#   in local/session storage; this .env fallback keeps queue identity stable when
#   the local API receives a queue heartbeat without browser auth headers.
#
# LIQ2_NICKNAME
#   Optional nickname/remark uploaded to private.superarb.ai.
#
# LIQ2_PRIVATE_MEMBER_BOOTSTRAP_PASSWORD
#   Optional password for advanced users. If empty, liq2 derives a stable local
#   bootstrap password for the private profile.
#
# WALLET_USDT_BALANCE
#   Optional cached wallet USDT balance uploaded when already available locally.
PRIVATE_KEY=
SUPERMTNODE_APP_TOKEN=
AUTH_CODE=
LIQ2_NICKNAME=
LIQ2_PRIVATE_MEMBER_BOOTSTRAP_PASSWORD=
WALLET_USDT_BALANCE=

# -----------------------------------------------------------------------------
# 2. Execution Policy
# -----------------------------------------------------------------------------
# Settings > 通用 / 凭证管理:
# - 资金模式 -> FUNDING_MODE
# - 套利强度 -> ARBITRAGE_INTENSITY
# - 授权金额 -> SINGLE_TRADE_AUTH_AMOUNT_USDT
# - 凭证管理 -> CREDENTIAL_AUTH_MODE
# - 启动检测 -> STARTUP_DETECTION_MODE
#
# FUNDING_MODE
#   flash_loan | self_funded
#
# ARBITRAGE_INTENSITY
#   conservative | enhanced | aggressive
#
# SINGLE_TRADE_AUTH_AMOUNT_USDT
#   USDT authorization amount for one execution authorization cycle.
#
# CREDENTIAL_AUTH_MODE
#   single | loop
#
# STARTUP_DETECTION_MODE
#   manual | auto
FUNDING_MODE=flash_loan
ARBITRAGE_INTENSITY=conservative
SINGLE_TRADE_AUTH_AMOUNT_USDT=100
CREDENTIAL_AUTH_MODE=single
STARTUP_DETECTION_MODE=manual


# -----------------------------------------------------------------------------
# 3. Dashboard
# -----------------------------------------------------------------------------
# Settings > 通用:
# - 端口设置 -> DASHBOARD_PORT
# - 启动音效 -> LAUNCH_SOUND_ENABLED
# - 界面语言 -> DASHBOARD_LANGUAGE
#
# DASHBOARD_PORT
#   Preferred local dashboard port. If the port is occupied, Vite may auto-pick
#   the next available port.
#
# LAUNCH_SOUND_ENABLED
#   enabled | disabled
#
# DASHBOARD_LANGUAGE
#   zh
DASHBOARD_PORT=4311
LAUNCH_SOUND_ENABLED=enabled
DASHBOARD_LANGUAGE=zh


# -----------------------------------------------------------------------------
# 4. RPC Endpoints
# -----------------------------------------------------------------------------
# Settings > RPC:
# - Ethereum -> ETHEREUM_RPC_URL
# - BNB -> BNB_RPC_URL
# - Arbitrum -> ARBITRUM_RPC_URL
# - Base -> BASE_RPC_URL
# - Polygon -> POLYGON_RPC_URL
#
# BNB_RPC_URL is required for the current liquidation execution path.
# Other chains are optional but kept for dashboard/query/future multi-chain use.
ETHEREUM_RPC_URL=
BNB_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=
POLYGON_RPC_URL=


# -----------------------------------------------------------------------------
# 5. Public Feed
# -----------------------------------------------------------------------------
# Settings > 公共 Feed:
# - 清算快照接口 -> LIQUIDATION_SNAPSHOT_API_URL
# - 清算快照 Token -> LIQUIDATION_SNAPSHOT_TOKEN
# - 快照请求超时 -> LIQUIDATION_SNAPSHOT_TIMEOUT_MS
#
# Liquidation candidate snapshot service. Leave the official URL unless you run
# your own compatible keeper/indexer snapshot endpoint.
LIQUIDATION_SNAPSHOT_API_URL=https://bsc.rpc.supermtnode.io/api/public/liquidations/snapshot
LIQUIDATION_SNAPSHOT_TOKEN=
LIQUIDATION_SNAPSHOT_TIMEOUT_MS=8000
