# SuperARB / LIQ2 environment template
#
# Copy this file to .env before starting the dashboard.
# Windows:     copy .env.example .env
# macOS/Linux: cp .env.example .env
#
# Minimum required startup fields:
# - PRIVATE_KEY
# - SUPERMTNODE_APP_TOKEN
# - BNB_RPC_URL
# - AUTH_CODE
#
# Keep secrets out of screenshots, Git commits, issue reports, and chat logs.


# -----------------------------------------------------------------------------
# 1. Wallet & License
# -----------------------------------------------------------------------------
# Settings > 通用:
# - 钱包私钥 -> PRIVATE_KEY
# - SUPERMTNODE_APP_TOKEN -> SUPERMTNODE_APP_TOKEN
# - 授权码 -> AUTH_CODE
#
# PRIVATE_KEY
#   Required. Execution wallet private key. Use a dedicated operational wallet.
#
# SUPERMTNODE_APP_TOKEN
#   Required. Official SuperMTNode app/license token. RPC quota can be shared by
#   the same token + RPC endpoints across different private keys, while each
#   wallet remains separately metered by its own execution activity.
#
# AUTH_CODE
#   Required. SuperARB dashboard authorization code. The browser login stores it
#   The fixed verification endpoint is https://api.supermtnode.io/license/check.
#   in local/session storage; this .env fallback keeps queue identity stable when
#   the local API receives a queue heartbeat without browser auth headers.
#
# LIQ2_NICKNAME
#   Optional nickname/remark uploaded to private.superarb.ai.
#
# LIQ2_AVATAR_URL / LIQ2_BIO
#   Optional local cache of the profile saved through api.supermtglobal.com/avatar.
#
# LIQ2_USER_PASSWORD
#   Required before wallet bootstrap. It is submitted with the encrypted wallet
#   profile and required together with AUTH_CODE on subsequent dashboard login.
#   Set it in Settings instead of placing it in source control; Settings writes
#   LIQ2_LOGIN_PASSWORD_HASH for local verification.
#
# LIQ2_PRIVATE_MEMBER_BOOTSTRAP_PASSWORD
#   Legacy name accepted for existing installations. Prefer LIQ2_USER_PASSWORD.
#
# WALLET_USDT_BALANCE
#   Optional cached wallet USDT balance uploaded when already available locally.
#
# LIQ2_ONLINE_USERS_API_URL
#   New privateARB online-user list used by the execution ranking. The endpoint
#   reads only users whose wallet_presence heartbeat is fresh.
PRIVATE_KEY=
SUPERMTNODE_APP_TOKEN=
AUTH_CODE=
LIQ2_NICKNAME=
LIQ2_AVATAR_URL=
LIQ2_BIO=
LIQ2_USER_PASSWORD=
LIQ2_LOGIN_PASSWORD_HASH=
LIQ2_PASSWORD_CONFIGURED=false
# Set automatically while a replacement wallet still needs its own password.
# Do not set manually; saving a password in Settings clears this flag.
LIQ2_PASSWORD_SETUP_REQUIRED=false
LIQ2_PRIVATE_MEMBER_BOOTSTRAP_PASSWORD=
WALLET_USDT_BALANCE=
LIQ2_ONLINE_USERS_API_URL=https://privateapi.superarb.ai/online-users

# privateARB wallet activity ledger used by the Slots page. It returns only the
# wallet that proves ownership by signing the request in the local server.
PRIVATE_ARB_WALLET_ACTIVITY_URL=https://privateapi.superarb.ai/wallet-activity

# -----------------------------------------------------------------------------
# 2. Execution Policy
# -----------------------------------------------------------------------------
# Settings > 通用 / 凭证管理:
# - 资金模式 -> FUNDING_MODE
# - 套利强度 -> ARBITRAGE_INTENSITY
# - 授权金额 -> SINGLE_TRADE_AUTH_AMOUNT_USDT
# - 凭证管理 -> CREDENTIAL_AUTH_MODE
# - 启动检测 -> STARTUP_DETECTION_MODE
#
# FUNDING_MODE
#   flash_loan | self_funded
#
# ARBITRAGE_INTENSITY
#   conservative | enhanced | aggressive
#
# SINGLE_TRADE_AUTH_AMOUNT_USDT
#   USDT authorization amount for one execution authorization cycle.
#
# CREDENTIAL_AUTH_MODE
#   single | loop
#
# STARTUP_DETECTION_MODE
#   manual | auto
FUNDING_MODE=flash_loan
ARBITRAGE_INTENSITY=conservative
SINGLE_TRADE_AUTH_AMOUNT_USDT=100
CREDENTIAL_AUTH_MODE=single
STARTUP_DETECTION_MODE=manual


# -----------------------------------------------------------------------------
# 3. Dashboard
# -----------------------------------------------------------------------------
# Settings > 通用 / 提示音设置:
# - 端口设置 -> DASHBOARD_PORT
# - 启动音效 -> LAUNCH_SOUND_ENABLED
# - 界面语言 -> DASHBOARD_LANGUAGE
# - 奖励到帐 -> REWARD_RECEIVED_SOUND
# - 需要升级 -> UPGRADE_REQUIRED_SOUND
# - 升级完成 -> UPGRADE_COMPLETED_SOUND
# - 卡槽锚定 -> SLOT_ANCHORED_SOUND
#
# DASHBOARD_PORT
#   Preferred local dashboard port. If the port is occupied, Vite may auto-pick
#   the next available port.
#
# LAUNCH_SOUND_ENABLED
#   enabled | disabled
#
# DASHBOARD_LANGUAGE
#   zh
#
# *_SOUND
#   sound_1 | sound_2 | sound_3 | sound_4 | sound_5
DASHBOARD_PORT=4311
LAUNCH_SOUND_ENABLED=enabled
DASHBOARD_LANGUAGE=zh
REWARD_RECEIVED_SOUND=sound_1
UPGRADE_REQUIRED_SOUND=sound_2
UPGRADE_COMPLETED_SOUND=sound_3
SLOT_ANCHORED_SOUND=sound_4


# -----------------------------------------------------------------------------
# 4. RPC Endpoints
# -----------------------------------------------------------------------------
# Settings > RPC:
# - Ethereum -> ETHEREUM_RPC_URL
# - BNB -> BNB_RPC_URL
# - Arbitrum -> ARBITRUM_RPC_URL
# - Base -> BASE_RPC_URL
# - Polygon -> POLYGON_RPC_URL
#
# BNB_RPC_URL is required for the current liquidation execution path.
# Other chains are optional but kept for dashboard/query/future multi-chain use.
ETHEREUM_RPC_URL=
BNB_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=
POLYGON_RPC_URL=


# -----------------------------------------------------------------------------
# 5. Public Feed
# -----------------------------------------------------------------------------
# Settings > 公共 Feed:
# - 清算快照接口 -> LIQUIDATION_SNAPSHOT_API_URL
# - 清算快照 Token -> LIQUIDATION_SNAPSHOT_TOKEN
# - 快照请求超时 -> LIQUIDATION_SNAPSHOT_TIMEOUT_MS
#
# Liquidation candidate snapshot service. Leave the official URL unless you run
# your own compatible keeper/indexer snapshot endpoint.
LIQUIDATION_SNAPSHOT_API_URL=https://market-snapshot.superarb.ai/api/public/liquidations/snapshot
LIQUIDATION_SNAPSHOT_TOKEN=
LIQUIDATION_SNAPSHOT_TIMEOUT_MS=8000

# Central SuperARB news service. The dashboard proxies /api/news to this endpoint.
MANAGE_NEWS_API_URL=https://news.superarb.ai/api/public/news
