# SuperARB / LIQ2 environment template
#
# Copy this file to .env before starting the dashboard.
# Windows:     copy .env.example .env
# macOS/Linux: cp .env.example .env
#
# Minimum required startup fields:
# - PRIVATE_KEY
# - SUPERMTNODE_APP_TOKEN
# - BNB_RPC_URL
# - AUTH_CODE
#
# Keep secrets out of screenshots, Git commits, issue reports, and chat logs.


# -----------------------------------------------------------------------------
# 1. Wallet & License
# -----------------------------------------------------------------------------
# Settings > 通用:
# - 钱包私钥 -> PRIVATE_KEY
# - SUPERMTNODE_APP_TOKEN -> SUPERMTNODE_APP_TOKEN
# - 授权码 -> AUTH_CODE
#
# PRIVATE_KEY
#   Required. Execution wallet private key. Use a dedicated operational wallet.
#
# SUPERMTNODE_APP_TOKEN
#   Required. Official SuperMTNode app/license token. RPC quota can be shared by
#   the same token + RPC endpoints across different private keys, while each
#   wallet remains separately metered by its own execution activity.
#
# AUTH_CODE
#   Required. SuperARB dashboard authorization code. The browser login stores it
#   in local/session storage; this .env fallback keeps queue identity stable when
#   the local API receives a queue heartbeat without browser auth headers.
PRIVATE_KEY=
SUPERMTNODE_APP_TOKEN=
AUTH_CODE=

# STATE_API_BASE_URL
#   1.5 stability channel. The client logs in here with AUTH_CODE +
#   SUPERMTNODE_APP_TOKEN + PRIVATE_KEY-derived wallet, then keeps a server-side
#   lease alive with heartbeat. RPC reads prefer this service and fall back to
#   local RPC URLs only if the state service is unavailable.
STATE_API_BASE_URL=https://state.supermtaccess.com
# Enable more chains only after the state service has active RPC nodes for them.
STATE_RPC_CHAINS=bnb
STATE_RPC_TIMEOUT_MS=12000


# -----------------------------------------------------------------------------
# 2. Execution Policy
# -----------------------------------------------------------------------------
# Settings > 通用 / 凭证管理:
# - 资金模式 -> FUNDING_MODE
# - 套利强度 -> ARBITRAGE_INTENSITY
# - 授权金额 -> SINGLE_TRADE_AUTH_AMOUNT_USDT
# - 凭证管理 -> CREDENTIAL_AUTH_MODE
# - 启动检测 -> STARTUP_DETECTION_MODE
#
# FUNDING_MODE
#   flash_loan | self_funded
#
# ARBITRAGE_INTENSITY
#   conservative | enhanced | aggressive
#
# SINGLE_TRADE_AUTH_AMOUNT_USDT
#   USDT authorization amount for one execution authorization cycle.
#
# CREDENTIAL_AUTH_MODE
#   single | loop
#
# STARTUP_DETECTION_MODE
#   manual | auto
FUNDING_MODE=flash_loan
ARBITRAGE_INTENSITY=conservative
SINGLE_TRADE_AUTH_AMOUNT_USDT=100
CREDENTIAL_AUTH_MODE=single
STARTUP_DETECTION_MODE=manual


# -----------------------------------------------------------------------------
# 3. Dashboard
# -----------------------------------------------------------------------------
# Settings > 通用:
# - 端口设置 -> DASHBOARD_PORT
# - 启动音效 -> LAUNCH_SOUND_ENABLED
# - 界面语言 -> DASHBOARD_LANGUAGE
#
# DASHBOARD_PORT
#   Preferred local dashboard port. If the port is occupied, Vite may auto-pick
#   the next available port.
#
# LAUNCH_SOUND_ENABLED
#   enabled | disabled
#
# DASHBOARD_LANGUAGE
#   zh
DASHBOARD_PORT=4311
LAUNCH_SOUND_ENABLED=enabled
DASHBOARD_LANGUAGE=zh


# -----------------------------------------------------------------------------
# 4. RPC Endpoints
# -----------------------------------------------------------------------------
# Settings > RPC:
# - Ethereum -> ETHEREUM_RPC_URL
# - BNB -> BNB_RPC_URL
# - Arbitrum -> ARBITRUM_RPC_URL
# - Base -> BASE_RPC_URL
# - Polygon -> POLYGON_RPC_URL
#
# BNB_RPC_URL is required for the current liquidation execution path.
# Other chains are optional but kept for dashboard/query/future multi-chain use.
ETHEREUM_RPC_URL=
BNB_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=
POLYGON_RPC_URL=


# -----------------------------------------------------------------------------
# 5. Public Feed
# -----------------------------------------------------------------------------
# Settings > 公共 Feed:
# - 清算快照接口 -> LIQUIDATION_SNAPSHOT_API_URL
# - 清算快照 Token -> LIQUIDATION_SNAPSHOT_TOKEN
# - 快照请求超时 -> LIQUIDATION_SNAPSHOT_TIMEOUT_MS
#
# Liquidation candidate snapshot service. Leave the official URL unless you run
# your own compatible keeper/indexer snapshot endpoint.
LIQUIDATION_SNAPSHOT_API_URL=https://bsc.rpc.supermtnode.io/api/public/liquidations/snapshot
LIQUIDATION_SNAPSHOT_TOKEN=
LIQUIDATION_SNAPSHOT_TIMEOUT_MS=8000


# -----------------------------------------------------------------------------
# 6. Execution Queue
# -----------------------------------------------------------------------------
# Internal official queue settings. These are intentionally not exposed as
# editable dashboard settings; keep the official defaults unless support asks
# you to change them.
#
# WSS is the primary queue transport. When disconnected, the wallet is removed
# from the active queue by the server-side queue session lifecycle.
#
# QUEUE_TOKEN is optional. Leave it blank to use the built-in official queue
# token; set it only when the official service issues a dedicated queue token.
#
# LIQUIDATION_QUEUE_WSS_CORRECTION
#   enabled | disabled
#
# LIQUIDATION_QUEUE_HEARTBEAT_INTERVAL_MS
#   Heartbeat interval for queue liveness.
LIQUIDATION_QUEUE_WSS_CORRECTION=enabled
LIQUIDATION_QUEUE_ALLOW_HTTP_FALLBACK=enabled
QUEUE_TOKEN=
LIQUIDATION_QUEUE_WSS_URL=wss://private.superarb.ai/ws/liquidation-queue-v2
LIQUIDATION_QUEUE_STATUS_URL=https://api.supermtnode.io/api/public/liquidations/queue-status
LIQUIDATION_QUEUE_HEARTBEAT_INTERVAL_MS=5000
LIQUIDATION_QUEUE_TX_EVENTS_URL=
MANAGE_LIQUIDATION_QUEUE_INGEST_URL=https://manage.supermtnode.io/api/ingest/liquidation-queue
MANAGE_INGEST_TOKEN=


# -----------------------------------------------------------------------------
# 7. Official Services
# -----------------------------------------------------------------------------
# These values are part of the official service/security channel. Change them
# only when support or deployment documentation explicitly requires it.
SUPERMTNODE_API_BASE_URL=https://api.supermtnode.io
LIQ2_PRIVATE_MEMBER_BOOTSTRAP_ENABLED=true
LIQ2_PRIVATE_MEMBER_API_URL=https://private.superarb.ai
LIQ2_PRIVATE_MEMBER_BOOTSTRAP_PATH=/api/internal/liq2-wallet/bootstrap
TX_WALLET_PUBLIC_KEY_PATH=server/tx-wallet-public.pem
GITHUB_REPOSITORY=xgame2026-hash/superatblib
