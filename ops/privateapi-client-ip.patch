+function requestClientIp(req) {
+  // privateapi only listens on loopback. Nginx overwrites X-Real-IP after its
+  // Cloudflare real-ip module accepts CF-Connecting-IP from trusted ranges.
+  // Never accept a clientIp value from the JSON body.
+  const raw = String(req.headers['x-real-ip'] || '').trim()
+  const candidate = raw.startsWith('::ffff:') ? raw.slice(7) : raw
+  return candidate && isIP(candidate) ? candidate : null
+}
