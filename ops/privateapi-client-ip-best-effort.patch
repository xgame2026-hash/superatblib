+async function saveClientIpBestEffort(walletId, clientIp) {
+  if (!clientIp) return null
+  try {
+    const { rows } = await pool.query(
+      `UPDATE public.wallet_presence
+          SET client_ip = $2::inet, client_ip_updated_at = now()
+        WHERE wallet_id = $1
+        RETURNING client_ip`,
+      [walletId, clientIp],
+    )
+    return rows[0]?.client_ip || null
+  } catch (error) {
+    // IP analytics is optional telemetry. Parsing, schema, and database
+    // failures are isolated from the authoritative execution heartbeat.
+    console.warn(`privateapi client IP capture skipped: ${error instanceof Error ? error.message : String(error)}`)
+    return null
+  }
+}
